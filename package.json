{
  "name": "sirat",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker:embedding": "ts-node-dev --respawn --transpile-only src/workers/driverEmbedding.worker.ts",
    "location:dev": "ts-node-dev --respawn --transpile-only src/location-service/location.server.ts",
    "worker:ride-timeout": "ts-node-dev --respawn --transpile-only src/workers/rideTimeout.scheduler.worker.ts",
    "simulator:drivers": "ts-node-dev --respawn --transpile-only src/simulator/driverSimulator.ts",
    "reset:loadtest": "ts-node-dev --transpile-only --exit-child src/scripts/resetLoadTestData.ts",
    "embeddings:queue-missing": "ts-node-dev --transpile-only --exit-child src/scripts/queueMissingDriverEmbeddings.ts",
    "nginx:dev": "docker run --rm -p 8080:8080 -v %cd%/nginx/sirat.conf:/etc/nginx/nginx.conf:ro nginx:alpine",
    "worker:dispatch": "ts-node-dev --respawn --transpile-only src/workers/dispatch.worker.ts",
    "build": "tsc",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.48.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.71.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "h3-js": "^4.4.0",
    "ioredis": "^5.10.1",
    "mongoose": "^9.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}